GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Upstash Redis (REST). OPTIONAL — without it the handover/PR/pair stores fall
# back to per-container memory, and the browser keeps a local copy of anything
# it publishes, so the flow still works end-to-end on one device. Attach a real
# database when you need handover links to survive a redeploy or open on
# someone else's machine.
#
# Auto-injected by the Vercel "Upstash for Redis" marketplace integration under
# the KV_REST_API_* names. For local dev, copy these from the Upstash database
# page in the Vercel dashboard (or from upstash.com → REST API tab).
#
# Check which backend is live at any time: GET /api/store-health
KV_REST_API_URL=
KV_REST_API_TOKEN=
